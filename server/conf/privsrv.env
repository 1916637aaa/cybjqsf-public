# ============================================================
#  私服统一配置 —— 安装时由 install.sh 自动填写，也可手动修改
#  改完执行： sudo systemctl restart privsrv agentsrv privsrv-admin privsrv-proxy privsrv-dns privsrv-dot
# ============================================================

# 【必填】本服务器的公网 IP（手机/客户端要连的地址）。
#   - 必须是"别人手机上能访问到"的地址，不是 127.0.0.1
#   - 云服务器填公网 IP；局域网自建填局域网 IP（手机需同网段）
#   - 用途：DNS 劫持返回的 A 记录、代理白名单、后台/DoT 证书 SAN、游戏 Host 判定
PRIVSRV_IP=

# 【可选】上游 DNS（DNS 劫持服务转发非游戏域名用），默认阿里 223.5.5.5
PRIVSRV_UPSTREAM=223.5.5.5

# 【可选】Android「私人 DNS」用的域名。
#   留空则自动生成 <IP 把点换成横线>.nip.io（如 1.2.3.4 -> 1-2-3-4.nip.io）
#   nip.io 会把这种域名解析回对应 IP，无需自己注册域名。
PRIVSRV_DOMAIN=

# 【可选】node 可执行文件路径（用于 lz4 编码）。留空则自动从 PATH 查找。
NODE_BIN=

# 【可选】DoT 证书路径，留空用 certs/dot.crt / dot.key
PRIVSRV_DOT_CERT=
PRIVSRV_DOT_KEY=

# ---- 以下端口为程序内部约定，一般不要改（改了要同步改 nginx/systemd/客户端）----
# 8443  = HTTP 后端 server.py
# 8765  = WebSocket agentsrv.py（nginx /agent 转发）
# 38443 = 后台管理 HTTPS admin.py
# 8080  = HTTP CONNECT 代理 proxysrv.py（手机 WiFi 代理端口）
# 53    = DNS 劫持 dnssrv.py
# 853   = DoT dotsrv.py
# 443   = nginx TLS（按 SNI 分发 hortor 域名）
# 80    = nginx 明文（ws /agent）
