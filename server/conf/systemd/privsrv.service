[Unit]
Description=Private Server HTTP backend (8443)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/privsrv
EnvironmentFile=/opt/privsrv/conf/privsrv.env
ExecStart=/usr/bin/python3 /opt/privsrv/server.py 8443 --http
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
