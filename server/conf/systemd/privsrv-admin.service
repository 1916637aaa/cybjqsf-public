[Unit]
Description=Private Server Admin Panel (HTTPS 38443)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/privsrv
EnvironmentFile=/opt/privsrv/conf/privsrv.env
ExecStart=/usr/bin/python3 /opt/privsrv/admin.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
