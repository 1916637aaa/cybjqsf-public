[Unit]
Description=Private Server HTTP CONNECT proxy (8080)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/privsrv
EnvironmentFile=/opt/privsrv/conf/privsrv.env
ExecStart=/usr/bin/python3 /opt/privsrv/proxysrv.py 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
